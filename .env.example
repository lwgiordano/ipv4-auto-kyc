# KYC Tool configuration — all settings via environment (prefix KYC_).
# Secrets come from your secret manager; never commit real values.

# development | test | production. In production, every process validates this
# whole config at startup and refuses to boot on any unsafe/stub setting.
KYC_ENVIRONMENT=development

KYC_DATABASE_URL=postgresql+psycopg://kyc:kyc@localhost:5432/kyc

# Platform integration (TODO(integration): values from the platform team)
KYC_PLATFORM_CALLBACK_URL=https://platform.example   # production: HTTPS, not localhost
KYC_PLATFORM_HMAC_SECRET=change-me                   # v1 legacy secret; needed until BOTH v1 sunsets pass (inbound verify + outbound dual-emit)
# KYC_AUTH_DISABLED=true        # dev/test only — never in production

# HMAC v2 (PR 5a — path-bound signing). Split inbound/outbound secrets + key_ids;
# both sunset dates + the observation window are REQUIRED in production.
KYC_HMAC_INBOUND_KEY_ID=kyc-platform-1
KYC_HMAC_INBOUND_SECRET=change-me                    # production: >= 32 chars
KYC_HMAC_OUTBOUND_KEY_ID=kyc-tool-1
KYC_HMAC_OUTBOUND_SECRET=change-me                   # production: >= 32 chars
KYC_HMAC_V1_INBOUND_SUNSET_AT=                       # ISO-8601; set with TechCraft at cutover
KYC_HMAC_V1_OUTBOUND_SUNSET_AT=                      # ISO-8601; independent of the inbound date
KYC_HMAC_V1_OBSERVATION_WINDOW_DAYS=14               # zero-v1 days required before the inbound sunset

# Operator auth (production: read API must be signed; UI needs an admin token)
# KYC_READ_AUTH_REQUIRED=true
# KYC_UI_ADMIN_TOKEN=

# Pluggable providers — dev stubs by default; production requires real ones.
# KYC_OCR_ENGINE=json_scan      # production: a real engine (not the stub)
# KYC_EMAIL_PROVIDER=logging    # production: e.g. ses (not the stub)
# KYC_ADAPTERS_PROFILE=fixture  # production: real (not fixtures)

# TEMPORARY safety hold: while approval-grade validators are hardened, computed
# approve / approve_buy_locked are held for manual review. Flip to true after.
# KYC_ENFORCE_POSITIVE_DECISIONS=false

# Normative policy files (defaults to the committed spec package)
# KYC_POLICY_DIR=/app/KYC_Tool_Build_Package/machine_readable

# Raw evidence storage: fs (dev) or s3 (prod; needs the s3 extra + AWS creds)
KYC_OBJECT_STORE=fs
# KYC_OBJECT_STORE_ROOT=/var/lib/kyc/evidence
# KYC_S3_BUCKET=ipv4-kyc-evidence

# Upstream credentials
# CH_API_KEY=                   # Companies House
# ARIN_API_KEY=                 # optional, raises RDAP rate limits

# Queue / workers
# KYC_JOB_LEASE_SECONDS=120
# KYC_JOB_MAX_ATTEMPTS=5   # 1..int4 max (jobs.max_attempts is int4)
# KYC_OUTBOX_MAX_ATTEMPTS=8   # 1..int4 max. NOT hot-swappable — see the canonical cutover below
#                             # (rendered from kyc_tool.ops.cutover.OUTBOX_MAX_ATTEMPTS_CUTOVER,
#                             # identical to DEPLOYMENT §8 and RUNBOOK):
# cutover:KYC_OUTBOX_MAX_ATTEMPTS:start
# KYC_OUTBOX_MAX_ATTEMPTS: both-direction DRAINED publisher cutover (NOT a rolling restart)
# 1. disable autoscaling and rolling restart
# 2. stop ALL publishers of roles: outbox_worker, dev_worker
# 3. attest zero publishers running of roles: outbox_worker, dev_worker
# 4. attest every new task definition carries KYC_OUTBOX_MAX_ATTEMPTS
# 5. start publishers of roles: outbox_worker, dev_worker
# cutover:KYC_OUTBOX_MAX_ATTEMPTS:end
# KYC_OUTBOX_MAX_ATTEMPTS_ATTESTED=   # cutover start gate, PER-PROCESS MITIGATION: set to the
#                             # reviewed target in every NEW task definition during the cutover;
#                             # a publisher whose live ceiling differs from ITS OWN attested pair
#                             # refuses to boot. It is self-attestation — it cannot detect an OLD
#                             # task definition whose pair is internally consistent, so steps 2-3
#                             # (drained stop + attest zero) remain the operative fleet control;
#                             # the independent DB cutover record lands with migration 028.
#                             # Unset outside a cutover window.
# KYC_ADAPTER_HARD_KILL_BOUNDARY=false  # run governed adapter fetches (real network clients
#                             # only) in a fork-per-call child TERMINATED at the absolute plan
#                             # deadline — bounds worker OCCUPANCY against hostile header/byte
#                             # drips, at a per-fetch fork cost. The in-process header/chunk/EOF
#                             # deadline proofs apply either way.
# KYC_OUTBOX_LEASE_SECONDS=300  # crash-detection window per claimed delivery (1..3600; an
                                # expired claim can neither stage evidence nor send). Must EXCEED
                                # 4 × KYC_OUTBOX_HTTP_TIMEOUT_SECONDS + margin, or a claim can
                                # expire mid-attempt — refused at boot in production.
# KYC_OUTBOX_HTTP_TIMEOUT_SECONDS=10  # per HTTPX inactivity phase. The publisher ENFORCES
                                # 4 × this as a hard wall-clock deadline on each whole attempt
                                # (send + status + ack-body drain), cancelling and retrying past
                                # it — which is what makes the lease rule above a guarantee.
# KYC_OUTBOX_LEASE_MARGIN_SECONDS=1.0  # DB commit/processing room added to that deadline.
                                # Raising the HTTP timeout raises the required lease FOUR-fold:
                                # move the two together or production refuses to boot. MUST be > 0
                                # in production (a zero margin leaves no room for the terminal write).

# One-shot ops/maintenance commands (verify_pr7b_*, reset/repair/restore). Two SEPARATE bounded
# budgets; statement MUST exceed lock (a statement ceiling at/below the lock budget cancels the
# lock wait first and misclassifies the failure). Each is capped at PostgreSQL's ~24.8-day
# (2147483647 ms) maximum; a larger value is refused before SET LOCAL with a governed sentinel.
# KYC_OPS_LOCK_TIMEOUT_SECONDS=60        # max wait to ACQUIRE a maintenance lock (1..); over it,
                                # the command refuses with OPS_COMMAND_LOCK_TIMEOUT, nothing changed.
# KYC_OPS_STATEMENT_TIMEOUT_SECONDS=360  # total per-statement ceiling (default 60 lock + 300 work);
                                # a runaway query refuses with OPS_COMMAND_STATEMENT_TIMEOUT.

# POC verification tokens
# KYC_POC_TOKEN_TTL_HOURS=72

# Compliance retention (default 7 years)
# KYC_RETENTION_DAYS=2555

# Ops console at /ui (debug tooling; composer/requeue endpoints mutate).
# Off by default; when enabled in production it requires KYC_UI_ADMIN_TOKEN.
# KYC_UI_ENABLED=false
