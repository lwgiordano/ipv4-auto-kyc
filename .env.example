# KYC Tool configuration — all settings via environment (prefix KYC_).
# Secrets come from your secret manager; never commit real values.

# development | test | production. In production, every process validates this
# whole config at startup and refuses to boot on any unsafe/stub setting.
KYC_ENVIRONMENT=development

KYC_DATABASE_URL=postgresql+psycopg://kyc:kyc@localhost:5432/kyc

# Platform integration (TODO(integration): values from the platform team)
KYC_PLATFORM_CALLBACK_URL=https://platform.example   # production: HTTPS, not localhost
KYC_PLATFORM_HMAC_SECRET=change-me                   # production: >= 32 chars
# KYC_AUTH_DISABLED=true        # dev/test only — never in production

# Operator auth (production: read API must be signed; UI needs an admin token)
# KYC_READ_AUTH_REQUIRED=true
# KYC_UI_ADMIN_TOKEN=

# Pluggable providers — dev stubs by default; production requires real ones.
# KYC_OCR_ENGINE=json_scan      # production: a real engine (not the stub)
# KYC_EMAIL_PROVIDER=logging    # production: e.g. ses (not the stub)
# KYC_ADAPTERS_PROFILE=fixture  # production: real (not fixtures)

# TEMPORARY safety hold: while approval-grade validators are hardened, computed
# approve / approve_buy_locked are held for manual review. Flip to true after.
# KYC_ENFORCE_POSITIVE_DECISIONS=false

# Normative policy files (defaults to the committed spec package)
# KYC_POLICY_DIR=/app/KYC_Tool_Build_Package/machine_readable

# Raw evidence storage: fs (dev) or s3 (prod; needs the s3 extra + AWS creds)
KYC_OBJECT_STORE=fs
# KYC_OBJECT_STORE_ROOT=/var/lib/kyc/evidence
# KYC_S3_BUCKET=ipv4-kyc-evidence

# Upstream credentials
# CH_API_KEY=                   # Companies House
# ARIN_API_KEY=                 # optional, raises RDAP rate limits

# Queue / workers
# KYC_JOB_LEASE_SECONDS=120
# KYC_JOB_MAX_ATTEMPTS=5
# KYC_OUTBOX_MAX_ATTEMPTS=8

# POC verification tokens
# KYC_POC_TOKEN_TTL_HOURS=72

# Compliance retention (default 7 years)
# KYC_RETENTION_DAYS=2555

# Ops console at /ui (debug tooling; composer/requeue endpoints mutate).
# Off by default; when enabled in production it requires KYC_UI_ADMIN_TOKEN.
# KYC_UI_ENABLED=false
