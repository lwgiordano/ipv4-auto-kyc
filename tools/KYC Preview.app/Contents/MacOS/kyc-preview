#!/bin/bash
# KYC Preview — the console's screens on sample data, and nothing behind them.
#
# Nothing here talks to a database or an API, so no button that writes will work: the page answers
# its own requests from a captured fixture and refuses to send. To actually run the thing --
# Send Message, Approve Manually, a real decision written to a real row -- open KYC Full Stack.app.
#
# It finds your checkout, pulls the branch, builds the console into a local page, serves it, and
# opens a window on it. It keeps pulling in the background, so a push upstream repaints the window
# a few seconds later without you touching anything.
set -uo pipefail

# Finder starts a process with no terminal and a minimal PATH, so anything that goes wrong has
# nowhere to appear -- which is how double-clicking this looked like nothing happening at all,
# while the identical script run from a shell worked first time. Rather than guess at which of
# the two differences did it, hand the script to Terminal and let the run be visible: the same
# window, the same output, and Ctrl-C or closing it stops everything exactly as before.
# The flag matters as much as the test: by the time this script re-execs itself after a pull,
# stdout is the pipe to tee, so -t 1 is false and an unguarded check would open a second window.
if [ ! -t 1 ] && [ -z "${KYC_CONSOLE_TTY:-}" ]; then
  open -a Terminal "$0"
  exit 0
fi
export KYC_CONSOLE_TTY=1
# Homebrew and /usr/local are not on a non-login PATH, and Postgres usually lives in one of them.
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

# Bash reads a script off disk as it runs, so a pull that rewrites this file mid-run leaves it
# executing whatever now sits at the byte offset it had reached. Run from a copy and the checkout
# is free to change underneath.
if [ -z "${KYC_CONSOLE_SELF:-}" ]; then
  KYC_CONSOLE_SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  export KYC_CONSOLE_SELF
  copy="$(mktemp "${TMPDIR:-/tmp}/kyc-preview.XXXXXX")" || exit 1
  cat "$0" > "$copy" && chmod +x "$copy" || exit 1
  exec bash "$copy"
fi
SELF="$KYC_CONSOLE_SELF"   # the bundle on disk; "$0" is this run's throwaway copy

# Follows the branch you have checked out; set KYC_CONSOLE_BRANCH to pin one instead.
BRANCH="${KYC_CONSOLE_BRANCH:-}"
# Shared with KYC Full Stack.app on purpose: whichever you opened first already found the checkout.
STATE="$HOME/Library/Application Support/KYC Console"
mkdir -p "$STATE"
REPO_FILE="$STATE/repo-path"
LOG="$STATE/preview.log"
# Append, so the lines from before a self-restart are still there to read.
[ -n "${KYC_CONSOLE_RESTARTS:-}" ] || : > "$LOG"
exec > >(tee -a "$LOG") 2>&1

# An AppleScript string literal, from arbitrary text: escape the two characters it cares about,
# then fold real newlines into the two-character escape it reads as a newline. Interpolating raw
# text into -e "..." breaks the literal and the dialog silently never appears.
aesc() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' \
    | awk '{ if (NR>1) printf "\\n"; printf "%s", $0 }'
}

say() {
  osascript >/dev/null 2>&1 <<OSA
display dialog "$(aesc "$1")" buttons {"OK"} default button 1 with title "KYC Preview" with icon caution
OSA
}

valid() { [ -n "${1:-}" ] && [ -f "$1/scripts/preview.py" ] && [ -f "$1/src/kyc_tool/ui/console.html" ]; }

# This bundle ships inside the repo, so the first and best guess is its own location: walk up
# from the executable until a checkout appears. A copy dragged to /Applications falls through to
# the remembered path, then a search, then asking.
REPO=""
here="$(cd "$(dirname "$SELF")" && pwd)"
while [ "$here" != "/" ]; do
  if valid "$here"; then REPO="$here"; break; fi
  here="$(dirname "$here")"
done
if ! valid "$REPO" && [ -f "$REPO_FILE" ]; then REPO="$(cat "$REPO_FILE")"; fi
if ! valid "$REPO"; then
  REPO="$(find "$HOME" -maxdepth 6 -type d -name ipv4-auto-kyc -not -path '*/node_modules/*' 2>/dev/null | head -1)"
fi
if ! valid "$REPO"; then
  PICK="$(osascript -e 'try
    set f to choose folder with prompt "Where is your ipv4-auto-kyc checkout?"
    POSIX path of f
  end try' 2>/dev/null)"
  REPO="${PICK%/}"
fi
if ! valid "$REPO"; then
  say "I could not find your ipv4-auto-kyc checkout.

Clone it first:

    git clone https://github.com/lwgiordano/ipv4-auto-kyc.git

then open this app again and point it at that folder."
  exit 1
fi
printf '%s' "$REPO" > "$REPO_FILE"

PY="$(command -v python3 || true)"
if [ -z "$PY" ]; then
  say "This needs python3, which macOS installs with the Command Line Tools.

Run this in Terminal, then open the app again:

    xcode-select --install"
  exit 1
fi

# Pull first, then build what was pulled. preview.py keeps pulling while it serves, but that only
# helps once you are already running: the first launch used to build whatever you had on disk.
export GIT_TERMINAL_PROMPT=0  # a credential prompt here would just hang
if [ -n "$BRANCH" ] && [ -z "$(git -C "$REPO" status --porcelain 2>/dev/null)" ]; then
  git -C "$REPO" fetch --quiet origin "$BRANCH" 2>/dev/null
  git -C "$REPO" checkout --quiet "$BRANCH" 2>/dev/null || echo "could not switch to $BRANCH"
fi
BRANCH="$(git -C "$REPO" rev-parse --abbrev-ref HEAD 2>/dev/null)"
if [ -n "$(git -C "$REPO" status --porcelain 2>/dev/null)" ]; then
  echo "on $BRANCH with local changes — nothing will be pulled over them"
elif ! git -C "$REPO" rev-parse --abbrev-ref "@{u}" >/dev/null 2>&1; then
  echo "on $BRANCH, which has no upstream — nothing will be pulled"
else
  was="$(git -C "$REPO" rev-parse HEAD)"
  if git -C "$REPO" pull --ff-only --quiet 2>/dev/null; then
    now="$(git -C "$REPO" rev-parse HEAD)"
    if [ "$was" = "$now" ]; then
      echo "on $BRANCH — already current"
    else
      echo "pulled $BRANCH: ${was:0:7} → ${now:0:7}"
      git -C "$REPO" --no-pager log --oneline "$was..$now" | sed 's/^/  /'
      # That pull may have replaced this launcher; start the new one. The counter stops a bad
      # push turning it into a loop.
      if ! cmp -s "$SELF" "$0"; then
        if [ "${KYC_CONSOLE_RESTARTS:-0}" -lt 2 ]; then
          echo "the launcher itself changed — starting the new one"
          export KYC_CONSOLE_RESTARTS=$(( ${KYC_CONSOLE_RESTARTS:-0} + 1 ))
          unset KYC_CONSOLE_SELF
          rm -f "$0"
          exec bash "$SELF"
        fi
        echo "the launcher changed again — carrying on with this one"
      fi
    fi
  else
    echo "could not pull $BRANCH (offline, or it needs a merge) — building what you have"
  fi
fi

PORT="$("$PY" -c 'import socket;s=socket.socket();s.bind(("127.0.0.1",0));print(s.getsockname()[1]);s.close()')"
URL="http://127.0.0.1:$PORT/"

"$PY" "$REPO/scripts/preview.py" --port "$PORT" --no-open --interval 20 &
SERVER=$!
trap 'kill $SERVER 2>/dev/null; rm -f "$0"' EXIT INT TERM

for _ in $(seq 1 40); do
  curl -sf -o /dev/null "$URL" && break
  sleep 0.25
done

# A dedicated window, so it reads as an app rather than one more tab. Any of the three will do.
CHROME="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
EDGE="/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge"
BRAVE="/Applications/Brave Browser.app/Contents/MacOS/Brave Browser"
if   [ -x "$CHROME" ]; then "$CHROME" --app="$URL" --window-size=1440,960 >/dev/null 2>&1 &
elif [ -x "$EDGE"   ]; then "$EDGE"   --app="$URL" --window-size=1440,960 >/dev/null 2>&1 &
elif [ -x "$BRAVE"  ]; then "$BRAVE"  --app="$URL" --window-size=1440,960 >/dev/null 2>&1 &
else open "$URL"; fi

echo "serving $URL from $REPO"
echo "quit this app (Cmd-Q from the Dock) to stop it"
wait $SERVER
